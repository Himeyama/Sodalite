<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Sodalite.Views.ChatPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ComboBox x:Name="ModelComboBox" PlaceholderText="モデルを選択"
                          SelectionChanged="ModelComboBox_SelectionChanged" />
                <Button Grid.Column="1" x:Name="ResetButton" ToolTipService.ToolTip="会話をリセット"
                        Click="ResetButton_Click">
                    <FontIcon Glyph="&#xE74D;" />
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <ScrollViewer x:Name="MessagesScrollViewer" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MessagesPanel" Spacing="10" />
                </ScrollViewer>
                <ProgressRing x:Name="SendingProgressRing" Width="32" Height="32"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsActive="False" Visibility="Collapsed" />
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox x:Name="MessageTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                         PlaceholderText="メッセージを入力" PreviewKeyDown="MessageTextBox_KeyDown" />
                <Button Grid.Column="1" x:Name="SendButton" Style="{ThemeResource AccentButtonStyle}"
                        ToolTipService.ToolTip="送信 (Enter)" VerticalAlignment="Bottom" Click="SendButton_Click">
                    <FontIcon Glyph="&#xE724;" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
